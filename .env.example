# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database — Postgres (Neon / Supabase / self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/mcp_ai_chat?schema=public"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL=http://localhost:3000

# Providers — server-side keys (fallbacks, never expose to client)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# Encryption at rest for stored keys
ENCRYPTION_KEY="32-byte-hex-key"

# Object storage (S3-compatible) for attachments
S3_ENDPOINT=""
S3_BUCKET="mcp-attachments"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="us-east-1"

# Observability
# NEXT_PUBLIC_SENTRY_DSN=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# MCP
MCP_HEALTH_POLL_MS=30000
MCP_TIMEOUT_MS=10000
