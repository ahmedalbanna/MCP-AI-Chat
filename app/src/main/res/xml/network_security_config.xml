<?xml version="1.0" encoding="utf-8"?>
<!--
    Android's policy cannot express arbitrary RFC1918 ranges. EndpointPolicy
    therefore allows device-local HTTP, requires confirmation for private LAN
    HTTP, and rejects public cleartext endpoints before any request is built.
    Credential-bearing OkHttp clients also disable redirects.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
